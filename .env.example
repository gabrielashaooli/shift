# Copia este archivo a .env y llena los valores. .env NO se commitea.
# En producción estas van como secrets del Worker:
#   npm run build && npx wrangler secret put ANTHROPIC_API_KEY
# (desde la raíz: el build deja .wrangler/deploy/config.json apuntando al
#  wrangler.json generado; pasar --cwd .output/server hace que wrangler
#  vea dos configs y aborte)

# --- Intelligence Scan (obligatorio para que el scan corra) ---
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# --- Supabase (opcional: sin esto el scan funciona, pero no guarda el lead) ---
# Del dashboard de tu proyecto en supabase.com -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Las VITE_* se inyectan en el bundle del cliente: SOLO valores públicos.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
